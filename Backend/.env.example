# Environment mode: local or railway
ONDEEN_ENV=local
ONDEEN_LOCAL=1
ENV=local

# Flask/local server
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8088
PORT=8088
TZ=Africa/Casablanca
d_t_z=Africa/Casablanca
ONDEEN_SCHEDULER_TIMEZONE=Africa/Casablanca

# App secrets
SECRET_KEY=local-secret
JWT_SECRET_KEY=local-jwt-secret
# Optional Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# for user ids inside login tokens. Derived from JWT_SECRET_KEY when empty.
ONDEEN_ID_ENCRYPTION_KEY=
# Comma-separated browser origins allowed by CORS, e.g. the deployed admin console URL.
CORS_ALLOWED_ORIGINS=

# Local database. Railway injects DATABASE_URL from its PostgreSQL service.
DATABASE_URL=sqlite:///ondeen-local.db

# Local cache/rate limit. Railway can set REDIS_URL and RATELIMIT_STORAGE_URI=${REDIS_URL}.
REDIS_URL=
RATELIMIT_STORAGE_URI=memory://

# Local scheduler, SMS, and email delivery are disabled by default.
ENABLE_SCHEDULER=false
RUN_DB_BOOTSTRAP=false
SMS_SEND_ENABLED=false
EMAIL_SEND_ENABLED=false
SMS_API_URL=
SMS_AUTH_TOKEN=

# Local/test compatibility. The fixed OTP lets anyone sign in as any contact.
# Defaults to OFF when unset (including on Railway via ruh.sh). Only enable it
# explicitly on local or review environments, never on a public production API.
ONDEEN_TEST_OTP_ENABLED=true
ONDEEN_TEST_OTP_CODE=123456
# Optional comma-separated numbers that always accept the test OTP (e.g. store review).
# Defaults to none when unset.
ONDEEN_FIXED_OTP_NUMBERS=555999120

# Debug attendance: "Mark as Completed", future check-in and the default "123456"
# online code. Implied by ONDEEN_LOCAL=1; otherwise OFF unless set explicitly.
ONDEEN_ENABLE_DEBUG_ATTENDANCE=false

# File storage. Local defaults to app/static/uploads.
# Railway should set UPLOAD_ROOT=/data/uploads and UPLOAD_PUBLIC_BASE_URL=https://<railway-domain>.
UPLOAD_ROOT=
UPLOAD_PUBLIC_BASE_URL=
IMAGE_MAX_DIMENSION=2048
IMAGE_JPEG_QUALITY=84

# Public backend URL used for share/deep-link URLs.
# Leave these blank locally; run.sh and seed.sh auto-detect the Mac Wi-Fi URL.
ONDEEN_SEED_BASE_URL=
ONDEEN_PUBLIC_BASE_URL=
PUBLIC_BASE_URL=
EVENT_WEB_URL=

# Google OAuth. Set the client IDs that are allowed to sign in.
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Maps API key, if backend code needs it.
GOOGLE_MAPS_API_KEY=

# Minimal FCM for push notifications. Leave empty locally unless testing push sends.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=

# Existing app configuration
ORGANIZER_DEFAULT_STATUS=1
